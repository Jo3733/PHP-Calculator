<?php

$result = '';
$error = '';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $a = $_POST['a'] ?? '';
    $b = $_POST['b'] ?? '';
    $operation = $_POST['operation'] ?? '';

    if (!is_numeric($a) || !is_numeric($b)) {
        $error = 'Введите два числа';
    } else {
        $a = (float)$a;
        $b = (float)$b;

        switch ($operation) {
            case 'add':
                $result = $a + $b;
                break;

            case 'subtract':
                $result = $a - $b;
                break;

            case 'multiply':
                $result = $a * $b;
                break;

            case 'divide':
                if ($b == 0) {
                    $error = 'На ноль делить нельзя!';
                } else {
                    $result = $a / $b;
                }
                break;

            case 'percent':
                $result = $a * $b / 100;
                break;

            default:
                $error = 'Выберите операцию';
        }
    }
}
?>

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PHP Calculator</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            background: #111827;
            color: white;
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }

        .calculator {
            background: #1f2937;
            width: 350px;
            padding: 25px;
            border-radius: 20px;
            box-shadow: 0 10px 40px #0008;
        }

        h2 {
            text-align: center;
            margin-bottom: 25px;
        }

        input {
            width: 100%;
            padding: 15px;
            margin-bottom: 15px;
            border: none;
            border-radius: 10px;
            background: #374151;
            color: white;
            font-size: 18px;
        }

        .buttons {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
        }

        button {
            padding: 18px;
            border: none;
            border-radius: 10px;
            background: #4f46e5;
            color: white;
            font-size: 20px;
            cursor: pointer;
        }

        button:hover {
            background: #6366f1;
        }

        .result {
            background: #374151;
            padding: 15px;
            margin-top: 20px;
            border-radius: 10px;
            text-align: center;
            font-size: 20px;
            overflow-wrap: anywhere;
        }

        .error {
            color: #f87171;
        }
    </style>
</head>

<body>

<div class="calculator">

    <h2>PHP Calculator</h2>

    <form method="POST">

        <input
            type="number"
            step="any"
            name="a"
            placeholder="Первое число"
            required
        >

        <input
            type="number"
            step="any"
            name="b"
            placeholder="Второе число"
            required
        >

        <div class="buttons">

            <button name="operation" value="add">+</button>

            <button name="operation" value="subtract">−</button>

            <button name="operation" value="multiply">×</button>

            <button name="operation" value="divide">÷</button>

            <button name="operation" value="percent">%</button>

            <button type="reset">AC</button>

        </div>

    </form>

    <?php if ($error): ?>
        <div class="result error">
            <?= htmlspecialchars($error) ?>
        </div>
    <?php elseif ($result !== ''): ?>
        <div class="result">
            Результат: <strong>
                <?= htmlspecialchars((string)$result) ?>
            </strong>
        </div>
    <?php endif; ?>

</div>

</body>
</html>
